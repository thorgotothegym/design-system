{
  "name": "design-system",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "storybook": "turbo run storybook",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "size": "turbo run size",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "check:placeholders": "node scripts/check-placeholders.mts",
    "check:release": "node scripts/check-release.mts",
    "lighthouse": "lhci collect && lhci upload && node scripts/lighthouse-summary.mts && lhci assert",
    "test:consumer": "turbo run test:consumer",
    "test:storybook": "turbo run test:storybook",
    "test:scaffold": "node scripts/test-scaffold.mts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@lhci/cli": "0.15.1",
    "prettier": "3.9.6",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
