{
  "name": "@aleixvidal/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contrast": {
      "types": "./dist/contrast/index.d.ts",
      "import": "./dist/contrast/index.js"
    },
    "./css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/build-tokens.ts",
    "build": "pnpm generate && tsup && tsc -p tsconfig.build.json && cp generated/*.css dist/",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm generate && tsc --noEmit",
    "contrast": "node scripts/check-contrast.ts",
    "test": "pnpm generate && pnpm contrast && vitest run"
  },
  "devDependencies": {
    "@aleixvidal/eslint-config": "workspace:*",
    "@aleixvidal/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "style-dictionary": "5.8.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
