{
  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": "none"
    },
    "sm": {
      "$type": "shadow",
      "$value": "0 1px 2px 0 oklch(0 0 0 / 0.4)"
    },
    "md": {
      "$type": "shadow",
      "$value": "0 4px 8px -2px oklch(0 0 0 / 0.5)"
    },
    "lg": {
      "$type": "shadow",
      "$value": "0 12px 24px -4px oklch(0 0 0 / 0.6)"
    }
  }
}
