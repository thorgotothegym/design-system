{
  "font": {
    "mono": {
      "$type": "fontFamily",
      "$value": "\"IBM Plex Mono\", \"Geist Mono\", monospace"
    },
    "sans": {
      "$type": "fontFamily",
      "$value": "{font.mono}"
    }
  },
  "text": {
    "xs": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "xs-line-height": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "sm": {
      "$type": "dimension",
      "$value": "0.875rem"
    },
    "sm-line-height": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "md": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "md-line-height": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1.125rem"
    },
    "lg-line-height": {
      "$type": "dimension",
      "$value": "1.75rem"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "xl-line-height": {
      "$type": "dimension",
      "$value": "1.75rem"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "2xl-line-height": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "1.875rem"
    },
    "3xl-line-height": {
      "$type": "dimension",
      "$value": "2.25rem"
    }
  },
  "font-weight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "medium": {
      "$type": "fontWeight",
      "$value": 500
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700
    }
  },
  "leading": {
    "tight": {
      "$type": "number",
      "$value": 1.25
    },
    "normal": {
      "$type": "number",
      "$value": 1.5
    },
    "relaxed": {
      "$type": "number",
      "$value": 1.75
    }
  }
}
