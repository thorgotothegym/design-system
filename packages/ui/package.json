{
  "name": "@aleixvidal/ui",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./otp-input": {
      "types": "./dist/otp-input.d.ts",
      "import": "./dist/otp-input.js"
    },
    "./date-picker": {
      "types": "./dist/date-picker.d.ts",
      "import": "./dist/date-picker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "size": "size-limit",
    "test:consumer": "node scripts/consumer-smoke.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@aleixvidal/eslint-config": "workspace:*",
    "@aleixvidal/tokens": "workspace:*",
    "@aleixvidal/typescript-config": "workspace:*",
    "@size-limit/preset-small-lib": "14.3.0",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "eslint": "catalog:",
    "jsdom": "30.1.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "7.91.0",
    "size-limit": "14.3.0",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-roving-focus": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-switch": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "input-otp": "1.5.0",
    "react-aria-components": "1.22.1",
    "tailwind-merge": "3.7.0"
  },
  "size-limit": [
    {
      "name": "Field",
      "path": "dist/index.js",
      "import": "{ Field }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "10.2 kB"
    },
    {
      "name": "Input",
      "path": "dist/index.js",
      "import": "{ Input }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "9.2 kB"
    },
    {
      "name": "Checkbox",
      "path": "dist/index.js",
      "import": "{ Checkbox }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "13.5 kB"
    },
    {
      "name": "Switch",
      "path": "dist/index.js",
      "import": "{ Switch }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "12.5 kB"
    },
    {
      "name": "Textarea",
      "path": "dist/index.js",
      "import": "{ Textarea }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "8.8 kB"
    },
    {
      "name": "RadioGroup",
      "path": "dist/index.js",
      "import": "{ RadioGroup }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "17.8 kB"
    },
    {
      "name": "Select",
      "path": "dist/index.js",
      "import": "{ Select }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "36.6 kB"
    },
    {
      "name": "Slider",
      "path": "dist/index.js",
      "import": "{ Slider }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "17.5 kB"
    },
    {
      "name": "TagInput",
      "path": "dist/index.js",
      "import": "{ TagInput }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "16.4 kB"
    },
    {
      "name": "OtpInput",
      "path": "dist/otp-input.js",
      "import": "{ OtpInput }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "12.1 kB"
    },
    {
      "name": "DatePicker",
      "path": "dist/date-picker.js",
      "import": "{ DatePicker }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "73.2 kB"
    },
    {
      "name": "CSS (dist/styles.css)",
      "path": "dist/styles.css",
      "rolldown": false,
      "limit": "4.05 kB"
    }
  ]
}
