{
  "name": "@aleixvidal/ui",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "size": "echo 'size-limit budgets are added in T05'"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@aleixvidal/eslint-config": "workspace:*",
    "@aleixvidal/typescript-config": "workspace:*",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "eslint": "catalog:",
    "jsdom": "30.1.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "7.91.0",
    "storybook": "10.6.3",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@aleixvidal/tokens": "workspace:*",
    "@radix-ui/react-label": "2.1.17",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  }
}
