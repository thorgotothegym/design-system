{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "storybook",
  "installCommand": "cd ../.. && npx --yes \"$(node -p \"require('./package.json').packageManager\")\" install --frozen-lockfile",
  "buildCommand": "cd ../.. && npx --yes \"$(node -p \"require('./package.json').packageManager\")\" turbo run build --filter=@aleixvidal/storybook",
  "outputDirectory": "storybook-static",
  "ignoreCommand": "cd ../.. && npx --yes \"turbo@$(node -p \"require('./package.json').devDependencies.turbo\")\" query affected --packages @aleixvidal/storybook --base=\"$VERCEL_GIT_PREVIOUS_SHA\" --exit-code",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()"
        },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/files/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "design.aleixvidal.dev" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
