{
  "name": "@aleixvidal/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "node scripts/copy-fonts.ts && storybook dev -p 6006",
    "build": "node scripts/copy-fonts.ts && storybook build -o storybook-static && node scripts/brand-html.ts",
    "build:chromatic": "node scripts/copy-fonts.ts && storybook build -o storybook-static --stats-json",
    "brand-assets": "node scripts/copy-fonts.ts && node scripts/brand-assets.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project 'storybook-*'"
  },
  "devDependencies": {
    "@aleixvidal/eslint-config": "workspace:*",
    "@aleixvidal/tokens": "workspace:*",
    "@aleixvidal/typescript-config": "workspace:*",
    "@aleixvidal/ui": "workspace:*",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-themes": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "catalog:",
    "playwright": "1.64.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "7.91.0",
    "storybook": "10.6.3",
    "storybook-addon-pseudo-states": "10.6.3",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "8.3.5",
    "vitest": "catalog:"
  }
}
